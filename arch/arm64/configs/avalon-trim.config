# OnePlus Nord 4 (Avalon) build-time trim, merged last: after palawan.config
# and avalon.config. Every line here removes code the phone cannot reach, so
# that a config change costs the camera and audio work minutes instead of a
# full arm64 defconfig rebuild.
#
# The list is the live daily's own view of the hardware: the drivers under
# /sys/bus/*/drivers that have no bound device and the modules it loads
# (results/device/2026-11-22-trim/inventory/sysfs.txt, usage.txt: boot_id
# dfc624f6…, kernel 7.2.0-rc2-palawan+ #10, the 2026-11-21b daily). A driver
# that binds or a module that loads is kept, and so is anything a daily gate
# reads. Nothing here is an opinion about what the owner might want: an entry
# needs a device, a mount or an inventory line that is absent.

# The platform families arm64's defconfig enables. The board is ARCH_QCOM and
# nothing else: their clocks, pinctrl, firmware, reset and mailbox drivers are
# other vendors' silicon.
# CONFIG_ARCH_ASPEED is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_BST is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_SOPHGO is not set

# ACPI. The phone boots from ABL with a device tree: /sys/firmware/acpi and
# /sys/class/dmi do not exist, so drivers/acpi and its table parsers (APEI,
# IORT, GTDT, PPTT, PRMT, CPPC) compile and bind nothing. PNP is the ACPI
# device enumerator's sibling. EFI_PARTITION stays: it is the GPT parser the
# UFS LUNs are partitioned with, and it does not depend on CONFIG_EFI.
# CONFIG_ACPI is not set
# CONFIG_PNP is not set

# EFI runtime services. ABL loads the raw Image and hands over a DT; there is
# no EFI firmware, no EFI variables and no EFI stub in the boot path.
# CONFIG_EFI is not set

# PCI and virtio. /sys/bus/pci/devices and /sys/bus/virtio/devices are empty;
# the WLAN is ath11k's AHB path, storage is UFS and the modem is not on PCI.
# VIRTIO_MENU is the `menuconfig` whose default y selects VIRTIO and whose
# children default y, so it is the line that closes the menu; the clients are
# named too because palawan.config sets several of them =y.
# CONFIG_PCI is not set
# CONFIG_VIRTIO_MENU is not set
# CONFIG_VIRTIO is not set
# CONFIG_VIRTIO_MMIO is not set
# CONFIG_VIRTIO_BLK is not set
# CONFIG_VIRTIO_NET is not set
# CONFIG_VIRTIO_CONSOLE is not set
# CONFIG_VIRTIO_BALLOON is not set
# CONFIG_HW_RANDOM_VIRTIO is not set
# CONFIG_RPMSG_VIRTIO is not set
# CONFIG_XEN is not set

# Filesystems nothing mounts. /proc/mounts on the daily is ext4 (/), proc,
# sysfs, tmpfs, devtmpfs, configfs, pstore, debugfs, securityfs, cgroup2, bpf,
# tracefs, mqueue, hugetlbfs, fusectl and binfmt_misc; fuse and overlay are
# modules the root loads. btrfs, NFS and CIFS were built in and unused.
# CONFIG_BTRFS_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_CIFS is not set
# CONFIG_SQUASHFS is not set

# The non-Qualcomm AMBA and tee drivers that register and bind nothing: the
# PL011 UART, the PL050 keyboard/mouse and PL18x MMC are PrimeCell blocks this
# SoC does not carry, the ARM MHU mailbox is not the QCOM APCS one, and OP-TEE
# is not QSEE (the loaded qcomtee module is).
# CONFIG_SERIAL_AMBA_PL011 is not set
# CONFIG_SERIO_AMBAKMI is not set
# CONFIG_MMC_ARMMMCI is not set
# CONFIG_ARM_MHU is not set
# CONFIG_OPTEE is not set
# CONFIG_SPI_GPIO is not set
