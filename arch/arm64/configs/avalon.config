# OnePlus Nord 4 (Avalon) first-boot fragment, merged after palawan.config.
# The first boot is an initramfs only, with no module load: everything the
# console, the crash log and the USB gadget need is built in.

# Framebuffer console on the bootloader splash buffer (simple-framebuffer).
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# The display stack and the AA553-P-7-A0001 panel (Open entry 9). The board
# file turns the Palawan MDSS, DPU, DSI0 and its PHY on; palawan.config already
# builds DRM, DRM_MSM and the DSI PHYs in (arch/arm64/configs/palawan.config:106-108)
# and DRM_MSM selects DRM_PANEL (drivers/gpu/drm/msm/Kconfig:69), but nothing
# builds the panel driver. It is =y for the same reason as the rest: the first
# boot has no /lib/modules, and the panel has to be there before udev exists.
# BACKLIGHT_CLASS_DEVICE is the one dependency to check, and palawan.config
# already builds it in.
CONFIG_DRM_PANEL_ONEPLUS_AA553_P_7_A0001=y

# Persistent log across reboots, in the ramoops carveout the board DTS adds.
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# USB gadget: configfs with NCM network and ACM serial. The eUSB2 PHY pair
# and the PMIC repeater are part of that path.
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_PHY_SNPS_EUSB2=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y

# Mount devtmpfs on /dev before init runs.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# The firewall and container networking the server uses. ufw applies its policy
# with iptables-nft, and Docker creates its bridge and NAT chains through the
# same front end; xtables-nft translates every match and target through
# NFT_COMPAT into nf_tables expressions, and the server root loads no module.
# The legacy tables are built in as well: they are what check-config and the
# iptables-legacy tools look for, and IP_NF_FILTER and its siblings hang off
# the legacy sockopt interface (net/ipv4/netfilter/Kconfig:14-22,184-188), so
# leaving that out removes the filter table itself. The xt matches and targets
# are the ones ufw's rule files and Docker's chains name (conntrack, comment,
# addrtype, limit, LOG, REJECT, MASQUERADE, REDIRECT, and the IPv6 rt and hl
# matches ufw's before6.rules use). The nft native limit, log and reject
# expressions are built in too, so iptables-nft has a second path when a
# selector maps to one (its `limit` does).
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_CT=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_REJECT=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_HL=y
CONFIG_IP6_NF_MATCH_RT=y

# Gunyah, the hypervisor this SoC boots under, runs a watchdog that bites
# about 25 s after the bootloader hands over unless the kernel stops or
# pings it. qcom_scm registers the gunyah-wdt device when it finds Gunyah.
CONFIG_WATCHDOG=y
CONFIG_GUNYAH_WATCHDOG=y

# Safety net for an unattended agent-run boot: a stall becomes a panic, and
# panic=5 then resets. softlockup_panic and hung_task_panic are the two
# detectors the cmdline's parameters need compiled in (kernel/watchdog.c:423,
# kernel/hung_task.c:446); the bootparam defaults make every image from this
# fragment panic even when a test overrides the cmdline. CONFIG_DETECT_HUNG_TASK
# is what compiles kernel/hung_task.c at all (kernel/Makefile:104).
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
CONFIG_DETECT_HUNG_TASK=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=1

# ADSP and the PMIC GLINK battery manager (Open entry 7). The initramfs has no
# /lib/modules, so the remoteproc, its GLINK transport and the power-supply
# client must all be built in. QCOM_Q6V5_PAS is limited to =m while
# QCOM_SYSMON or RPMSG_QCOM_GLINK_SMEM is =m (drivers/remoteproc/Kconfig:218-230);
# BATTERY_QCOM_BATTMGR needs QCOM_PMIC_GLINK (drivers/power/supply/Kconfig:211-218),
# which palawan.config already builds in. The ADSP firmware itself is not in this
# tree: a test initramfs stages adsp2.mdt and adsp2_dtb.mdt from the phone's own
# firmware_mnt (F0032).
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_SYSMON=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_BATTERY_QCOM_BATTMGR=y

# The IPCRTR transport. PMIC GLINK's clients are gated on a protection-domain
# service (pmic_glink.c:344-350 looks up "tms/servreg"/"msm/adsp/charger_pd"),
# which is reached over QRTR; qcom_battmgr answers -EAGAIN until that service is
# up (qcom_battmgr.c:1613-1618). The ADSP advertises the IPCRTR glink channel
# (stock Android lists it under /sys/bus/rpmsg/devices), and qrtr-smd is the
# driver that binds it (net/qrtr/smd.c:93); as a module it never binds in an
# initramfs boot, so build it in.
CONFIG_QRTR_SMD=y

# The protection-domain mapper, the SERVREG locator the ADSP's battery
# service resolves through. The ADSP's remoteproc starts a "pd-mapper"
# auxiliary device in its prepare step, before the firmware is loaded
# (drivers/remoteproc/qcom_common.c:548-580, qcom_q6v5_pas.c:829), and
# qcom_pd_mapper answers SERVREG_LOC for the machine's compatible
# (drivers/soc/qcom/qcom_pd_mapper.c:601, 651-654, 684-685). PMIC GLINK's PDR
# lookup of "tms/servreg"/"msm/adsp/charger_pd" (pmic_glink.c:344-350) is a
# SERVREG_LOC client (pdr_interface.c:681) and stays silent until that server
# announces itself (pdr_interface.c:459-470); the SM8550 map carries
# adsp_charger_pd (qcom_pd_mapper.c:262-265). As a module it never binds in an
# initramfs boot: the ADSP came up with no locator, no PDR state arrived and
# every qcom_battmgr read failed (F0039, F0051).
CONFIG_QCOM_PD_MAPPER=y

# The FastRPC compute driver, the userspace side of the CDSP the board enables
# in lamma-oneplus-avalon.dts. The initramfs has no /lib/modules, so it is built
# in; palawan.config leaves it as a module, and the driver needs RPMSG and
# selects QCOM_SCM (drivers/misc/Kconfig:301-306), both already built in.
CONFIG_QCOM_FASTRPC=y

# WCN6750 Wi-Fi behind the WPSS remoteproc (the Avalon WLAN). The remoteproc,
# its GLINK transport and the locator are built in above for the ADSP; ath11k's
# AHB bus is the WCN6750 path (drivers/net/wireless/ath/ath11k/Kconfig:2,13).
# RFKILL is =y because cfg80211 can only be a module while RFKILL is a module
# (net/wireless/Kconfig:17-19), and palawan.config's =y for CFG80211 and
# MAC80211 is otherwise silently reduced to =m. The WPSS firmware is staged from
# the phone's own modem partition by a test initramfs (F0037).
CONFIG_RFKILL=y
CONFIG_ATH11K=y
CONFIG_ATH11K_AHB=y

# The pack gauge, a bq27541 on qupv3_se12_i2c (lamma-oneplus-avalon.dts). The
# ADSP's battery object is not the pack (F0060), so the fuel gauge is the SOC
# the board reads. The initramfs has no /lib/modules, so both the core and the
# I2C transport are built in (drivers/power/supply/Kconfig:314-323).
CONFIG_BATTERY_BQ27XXX=y
CONFIG_BATTERY_BQ27XXX_I2C=y

# Audio (Open entry 13): the ADSP, AudioReach over GPR, the RX/TX/VA/WSA macro
# drivers, the WCD937x SoundWire codec, the SoundWire controllers and the card.
# All built in because the initramfs loads no modules, and the machine driver
# has to be =y for the QDSP6/APM side and the SoundWire helpers to be linked
# in rather than left as modules (sound/soc/qcom/Kconfig:198-204 selects
# SND_SOC_QCOM_COMMON and SND_SOC_QCOM_SDW, which palawan.config leaves =m).
# The sound tree is capped at the value of SOUND, then SND, then SND_SOC
# (sound/Kconfig:2-8,42-52, sound/soc/Kconfig:6), so all three have to be =y
# before any of the drivers below can be built in. QDSP6 selects the APM/PRM
# drivers (q6apm, q6prm) (sound/soc/qcom/Kconfig:137-156) and needs QCOM_APR,
# which palawan.config already sets; QCOM_Q6V5_ADSP only stays =y while its
# GLINK transport and QCOM_SYSMON are built in, which the ADSP block above
# does.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_QCOM=y
CONFIG_QCOM_Q6V5_COMMON=y
CONFIG_QCOM_Q6V5_ADSP=y
CONFIG_SND_SOC_QDSP6=y
CONFIG_SOUNDWIRE=y
CONFIG_SOUNDWIRE_QCOM=y
CONFIG_SND_SOC_WCD937X_SDW=y
CONFIG_SND_SOC_LPASS_RX_MACRO=y
CONFIG_SND_SOC_LPASS_TX_MACRO=y
CONFIG_SND_SOC_LPASS_VA_MACRO=y
CONFIG_SND_SOC_LPASS_WSA_MACRO=y
CONFIG_SND_SOC_SC8280XP=y
CONFIG_SND_SOC_TFA987X=y

# The reboot reason the bootloader reads: PMK8550 SDAM 0x7100 byte 0x48, bits
# 1..7, the cell downstream's pmk8550 restart_reason is and the one upstream's
# pmk8550 reboot-mode node writes (commit 138c427ade7b: mode-bootloader = 0x02).
# Both sides must be built in: the initramfs has no /lib/modules, and this is
# how the server leaves our kernel for fastboot without a button hold.
CONFIG_NVMEM_REBOOT_MODE=y
CONFIG_NVMEM_SPMI_SDAM=y

# Time across a reboot. palawan.config leaves RTC_DRV_PM8XXX=m, and neither the
# initramfs nor the server root loads modules. The PMK8550 RTC is the board's
# only clock that survives a power cycle, so build it in: RTC_HCTOSYS then reads
# it as the RTC device registers, before userspace starts (drivers/rtc/class.c,
# CONFIG_RTC_HCTOSYS_DEVICE = "rtc0").
CONFIG_RTC_DRV_PM8XXX=y

# The S3910 TouchComm v1 touchscreen. The first boot has no module loader, so
# the driver must be built into Image for the node on spi4 to probe.
# palawan.config builds in SPI and the GENI SPI master already; the driver
# reads the controller's identity at probe and requests no firmware.
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_SPI=y

# The iris video decoder, built in for the one image that carries it: the boot
# image is the only change this branch packs, and its initramfs loads no
# modules. Turning the driver on pulls the whole V4L2 core in with it
# (VIDEO_DEV and the videobuf2 helpers are modules in defconfig/palawan.config,
# and a built-in driver cannot depend on a module). These are the only symbols
# this fragment moves; NFC (nxp-nci) stays a module, as F0291 found it.
CONFIG_MEDIA_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_V4L2_MEM2MEM_DEV=y
CONFIG_VIDEOBUF2_CORE=y
CONFIG_VIDEOBUF2_V4L2=y
CONFIG_VIDEOBUF2_DMA_CONTIG=y
CONFIG_VIDEO_QCOM_IRIS=y

# The IR blaster and the alert slider (Open entry 57). Both are built in for
# the same reason as the rest of this fragment: the first boot has no module
# loader. rc-core is a module in defconfig, and LIRC is a bool inside
# "if RC_CORE" (drivers/media/rc/Kconfig:1-32, :359-364), so RC_CORE moves to
# =y; ir-spi is the SPI IR LED transmitter and the slider driver is the
# AK09970 hall switch on i2c0.
CONFIG_RC_CORE=y
CONFIG_LIRC=y
CONFIG_IR_SPI=y
CONFIG_INPUT_ONEPLUS_ALERT_SLIDER=y
# Cameras: the rear ultrawide (IMX355) path. The bus and clock plumbing is
# built in, but the four drivers that touch camera silicon are modules: a
# failed probe then happens on a running system with the console and ssh up
# (an oops stays an oops), instead of killing the boot before userspace. The
# test ramdisk does not load them and the rootfs has no copy, so nothing probes
# until the operator insmods them by hand (F0362, F0338).
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_QCOM_CAMSS=m
CONFIG_I2C_QCOM_CCI=m
CONFIG_VIDEO_IMX355=m
CONFIG_REGULATOR_AW37004=m
# vb2-dma-sg stays built in: a single-module build's modpost resolves symbols
# from vmlinux.symvers, so a *module* helper's export is invisible to
# qcom-camss.ko ("vb2_dma_sg_memops undefined"), while a built-in one is not.
CONFIG_VIDEOBUF2_DMA_SG=y
