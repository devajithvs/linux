# OnePlus Nord 4 (Avalon) first-boot fragment, merged after palawan.config.
# The first boot is an initramfs only, with no module load: everything the
# console, the crash log and the USB gadget need is built in.

# Framebuffer console on the bootloader splash buffer (simple-framebuffer).
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# The 8x16 font gives a 155x173 console on the 1240x2772 panel, too small to
# read from a photo; select the 16x32 Terminus font with fbcon=font:TER16x32.
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y

# Persistent log across reboots, in the ramoops carveout the board DTS adds.
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# USB gadget: configfs with NCM network and ACM serial. The eUSB2 PHY pair
# and the PMIC repeater are part of that path.
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_PHY_SNPS_EUSB2=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y

# Mount devtmpfs on /dev before init runs.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Gunyah, the hypervisor this SoC boots under, runs a watchdog that bites
# about 25 s after the bootloader hands over unless the kernel stops or
# pings it. qcom_scm registers the gunyah-wdt device when it finds Gunyah.
CONFIG_WATCHDOG=y
CONFIG_GUNYAH_WATCHDOG=y

# Safety net for an unattended agent-run boot: a stall becomes a panic, and
# panic=5 then resets. softlockup_panic and hung_task_panic are the two
# detectors the cmdline's parameters need compiled in (kernel/watchdog.c:423,
# kernel/hung_task.c:446); the bootparam defaults make every image from this
# fragment panic even when a test overrides the cmdline. CONFIG_DETECT_HUNG_TASK
# is what compiles kernel/hung_task.c at all (kernel/Makefile:104).
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y
