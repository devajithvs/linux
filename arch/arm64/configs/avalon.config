# OnePlus Nord 4 (Avalon) first-boot fragment, merged after palawan.config.
# The first boot is an initramfs only, with no module load: everything the
# console, the crash log and the USB gadget need is built in.

# Framebuffer console on the bootloader splash buffer (simple-framebuffer).
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Persistent log across reboots, in the ramoops carveout the board DTS adds.
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# USB gadget: configfs with NCM network and ACM serial. The eUSB2 PHY pair
# and the PMIC repeater are part of that path.
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_PHY_SNPS_EUSB2=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y

# Mount devtmpfs on /dev before init runs.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Gunyah, the hypervisor this SoC boots under, runs a watchdog that bites
# about 25 s after the bootloader hands over unless the kernel stops or
# pings it. qcom_scm registers the gunyah-wdt device when it finds Gunyah.
CONFIG_WATCHDOG=y
CONFIG_GUNYAH_WATCHDOG=y

# Safety net for an unattended agent-run boot: a stall becomes a panic, and
# panic=5 then resets. softlockup_panic and hung_task_panic are the two
# detectors the cmdline's parameters need compiled in (kernel/watchdog.c:423,
# kernel/hung_task.c:446); the bootparam defaults make every image from this
# fragment panic even when a test overrides the cmdline. CONFIG_DETECT_HUNG_TASK
# is what compiles kernel/hung_task.c at all (kernel/Makefile:104).
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
CONFIG_DETECT_HUNG_TASK=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=1

# ADSP and the PMIC GLINK battery manager (Open entry 7). The initramfs has no
# /lib/modules, so the remoteproc, its GLINK transport and the power-supply
# client must all be built in. QCOM_Q6V5_PAS is limited to =m while
# QCOM_SYSMON or RPMSG_QCOM_GLINK_SMEM is =m (drivers/remoteproc/Kconfig:218-230);
# BATTERY_QCOM_BATTMGR needs QCOM_PMIC_GLINK (drivers/power/supply/Kconfig:211-218),
# which palawan.config already builds in. The ADSP firmware itself is not in this
# tree: a test initramfs stages adsp2.mdt and adsp2_dtb.mdt from the phone's own
# firmware_mnt (F0032).
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_SYSMON=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_BATTERY_QCOM_BATTMGR=y

# The IPCRTR transport. PMIC GLINK's clients are gated on a protection-domain
# service (pmic_glink.c:344-350 looks up "tms/servreg"/"msm/adsp/charger_pd"),
# which is reached over QRTR; qcom_battmgr answers -EAGAIN until that service is
# up (qcom_battmgr.c:1613-1618). The ADSP advertises the IPCRTR glink channel
# (stock Android lists it under /sys/bus/rpmsg/devices), and qrtr-smd is the
# driver that binds it (net/qrtr/smd.c:93); as a module it never binds in an
# initramfs boot, so build it in.
CONFIG_QRTR_SMD=y

# The protection-domain mapper, the SERVREG locator the ADSP's battery
# service resolves through. The ADSP's remoteproc starts a "pd-mapper"
# auxiliary device in its prepare step, before the firmware is loaded
# (drivers/remoteproc/qcom_common.c:548-580, qcom_q6v5_pas.c:829), and
# qcom_pd_mapper answers SERVREG_LOC for the machine's compatible
# (drivers/soc/qcom/qcom_pd_mapper.c:601, 651-654, 684-685). PMIC GLINK's PDR
# lookup of "tms/servreg"/"msm/adsp/charger_pd" (pmic_glink.c:344-350) is a
# SERVREG_LOC client (pdr_interface.c:681) and stays silent until that server
# announces itself (pdr_interface.c:459-470); the SM8550 map carries
# adsp_charger_pd (qcom_pd_mapper.c:262-265). As a module it never binds in an
# initramfs boot: the ADSP came up with no locator, no PDR state arrived and
# every qcom_battmgr read failed (F0039, F0051).
CONFIG_QCOM_PD_MAPPER=y

# The FastRPC compute driver, the userspace side of the CDSP the board enables
# in lamma-oneplus-avalon.dts. The initramfs has no /lib/modules, so it is built
# in; palawan.config leaves it as a module, and the driver needs RPMSG and
# selects QCOM_SCM (drivers/misc/Kconfig:301-306), both already built in.
CONFIG_QCOM_FASTRPC=y

# WCN6750 Wi-Fi behind the WPSS remoteproc (the Avalon WLAN). The remoteproc,
# its GLINK transport and the locator are built in above for the ADSP; ath11k's
# AHB bus is the WCN6750 path (drivers/net/wireless/ath/ath11k/Kconfig:2,13).
# RFKILL is =y because cfg80211 can only be a module while RFKILL is a module
# (net/wireless/Kconfig:17-19), and palawan.config's =y for CFG80211 and
# MAC80211 is otherwise silently reduced to =m. The WPSS firmware is staged from
# the phone's own modem partition by a test initramfs (F0037).
CONFIG_RFKILL=y
CONFIG_ATH11K=y
CONFIG_ATH11K_AHB=y

# The pack gauge, a bq27541 on qupv3_se12_i2c (lamma-oneplus-avalon.dts). The
# ADSP's battery object is not the pack (F0060), so the fuel gauge is the SOC
# the board reads. The initramfs has no /lib/modules, so both the core and the
# I2C transport are built in (drivers/power/supply/Kconfig:314-323).
CONFIG_BATTERY_BQ27XXX=y
CONFIG_BATTERY_BQ27XXX_I2C=y

# Audio groundwork (Open entry 13): the ADSP, AudioReach over GPR, the RX/TX/VA/WSA
# macro drivers and the WCD937x SoundWire codec, all built in because the initramfs
# loads no modules. The board has no sound card yet: the SoundWire controllers, the
# codec variant and the amplifier driver are still missing (F0067), so the audio
# path stops at the DSP. The sound tree is capped at the value of SOUND, then SND,
# then SND_SOC (sound/Kconfig:2-8,42-52, sound/soc/Kconfig:6), so all three have to
# be =y before any of the drivers below can be built in. QDSP6 selects the APM/PRM
# drivers (q6apm, q6prm) (sound/soc/qcom/Kconfig:137-156) and needs QCOM_APR, which
# palawan.config already sets; QCOM_Q6V5_ADSP only stays =y while its GLINK
# transport and QCOM_SYSMON are built in, which the ADSP block above does.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_QCOM=y
CONFIG_QCOM_Q6V5_COMMON=y
CONFIG_QCOM_Q6V5_ADSP=y
CONFIG_SND_SOC_QDSP6=y
CONFIG_SOUNDWIRE=y
CONFIG_SOUNDWIRE_QCOM=y
CONFIG_SND_SOC_WCD937X_SDW=y
CONFIG_SND_SOC_LPASS_RX_MACRO=y
CONFIG_SND_SOC_LPASS_TX_MACRO=y
CONFIG_SND_SOC_LPASS_VA_MACRO=y
CONFIG_SND_SOC_LPASS_WSA_MACRO=y

# The reboot reason the bootloader reads: PMK8550 SDAM 0x7100 byte 0x48, bits
# 1..7, the cell downstream's pmk8550 restart_reason is and the one upstream's
# pmk8550 reboot-mode node writes (commit 138c427ade7b: mode-bootloader = 0x02).
# Both sides must be built in: the initramfs has no /lib/modules, and this is
# how the server leaves our kernel for fastboot without a button hold.
CONFIG_NVMEM_REBOOT_MODE=y
CONFIG_NVMEM_SPMI_SDAM=y
